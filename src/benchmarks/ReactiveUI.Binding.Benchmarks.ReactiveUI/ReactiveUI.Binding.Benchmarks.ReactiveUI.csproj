<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <!--
      BenchNetFx adds the net462 leg, which only Windows can launch. It also drops the EventPipe
      profiler, because that diagnoser refuses any job below .NET Core 3.0 and its validator stops
      the whole run rather than the one job.
    -->
    <TargetFrameworks Condition="'$(BenchNetFx)' == 'true' and $([MSBuild]::IsOsPlatform('Windows'))">net8.0;net10.0;net11.0;net462</TargetFrameworks>
    <DefineConstants Condition="'$(BenchNetFx)' == 'true' and $([MSBuild]::IsOsPlatform('Windows'))">$(DefineConstants);BENCH_NETFX</DefineConstants>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet"/>
    <PackageReference Include="ReactiveUI"/>
    <PackageReference Include="System.Reactive"/>
  </ItemGroup>

  <!-- Share view model / view types from the SourceGen benchmark project -->
  <ItemGroup>
    <Compile Include="..\ReactiveUI.Binding.Benchmarks\BenchmarkViewModel.cs" Link="BenchmarkViewModel.cs"/>
    <Compile Include="..\ReactiveUI.Binding.Benchmarks\BenchmarkChildViewModel.cs" Link="BenchmarkChildViewModel.cs"/>
    <Compile Include="..\ReactiveUI.Binding.Benchmarks\BenchmarkView.cs" Link="BenchmarkView.cs"/>
  </ItemGroup>

</Project>
